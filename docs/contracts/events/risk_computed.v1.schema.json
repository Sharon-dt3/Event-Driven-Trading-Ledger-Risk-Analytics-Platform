{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradepulse.dev/contracts/events/risk_computed.v1.schema.json",
  "title": "RiskComputed.v1",
  "description": "Computed risk metrics published to stream `risk.updates` by risk-engine.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "event_type": { "const": "RiskComputed" },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "account_id",
        "portfolio_value",
        "pnl",
        "volatility",
        "var",
        "var_method",
        "sharpe",
        "computed_at"
      ],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "portfolio_value": { "type": "number" },
        "pnl": { "type": "number" },
        "volatility": { "type": "number", "minimum": 0 },
        "var": { "type": "number", "minimum": 0, "description": "Value at Risk." },
        "var_method": { "type": "string", "enum": ["parametric", "historical"] },
        "sharpe": { "type": "number" },
        "computed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
