# Shared local configuration for docker compose (infra/docker-compose.yml).
# Copy to .env and adjust as needed. All values below are the compose defaults.

# PostgreSQL
POSTGRES_USER=tradepulse
POSTGRES_PASSWORD=tradepulse
POSTGRES_DB=tradepulse
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Phase 5: ledger-core Redis Streams publisher (wired, disabled by default)
LEDGER_STREAM_ENABLED=false
LEDGER_STREAM_NAME=ledger.updates

# Service ports (host)
MARKET_DATA_PORT=8081
LEDGER_CORE_PORT=8082
RISK_ENGINE_PORT=8083
GATEWAY_PORT=8084
DASHBOARD_PORT=3000

# Log level (structured logging)
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Public deployment (infra/docker-compose.public.yml) — REQUIRED for internet
# exposure. Generate strong random values; never reuse the demo defaults.
#   Generate a secret:  openssl rand -base64 48
# ---------------------------------------------------------------------------
# Public hostname whose DNS points at this host (Caddy gets a TLS cert for it).
DOMAIN=tradepulse.example.com
# Optional: email for Let's Encrypt expiry notices.
ACME_EMAIL=
# JWT signing secret (>= 32 chars). Rotating this invalidates all tokens.
LEDGER_JWT_SECRET=
# Application login passwords (usernames: admin, demo_trader, viewer, compliance).
LEDGER_AUTH_ADMIN_PASSWORD=
LEDGER_AUTH_TRADER_PASSWORD=
LEDGER_AUTH_VIEWER_PASSWORD=
LEDGER_AUTH_COMPLIANCE_PASSWORD=
