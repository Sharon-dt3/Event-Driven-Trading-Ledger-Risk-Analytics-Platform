# Shared local configuration for docker compose (infra/docker-compose.yml).
# Copy to .env and adjust as needed. All values below are the compose defaults.

# PostgreSQL
POSTGRES_USER=tradepulse
POSTGRES_PASSWORD=tradepulse
POSTGRES_DB=tradepulse
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports (host)
MARKET_DATA_PORT=8081
LEDGER_CORE_PORT=8082
RISK_ENGINE_PORT=8083
GATEWAY_PORT=8084
DASHBOARD_PORT=3000

# Log level (structured logging)
LOG_LEVEL=INFO
